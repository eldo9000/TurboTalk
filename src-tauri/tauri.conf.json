{
  "productName": "TurboTalk",
  "version": "0.0.1",
  "identifier": "io.librewin.turbotalk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1428",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TurboTalk",
        "width": 380,
        "height": 280,
        "minWidth": 320,
        "minHeight": 220,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "resizable": true,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
