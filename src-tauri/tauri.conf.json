{
  "productName": "Turbo Talk",
  "version": "0.0.1",
  "identifier": "io.librewin.turbotalk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1428",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Turbo Talk",
        "width": 440,
        "height": 280,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "resizable": false,
        "center": true,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "",
        "width": 260,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": true,
        "focus": false,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/whisper-cli"],
    "resources": {
      "binaries/libwhisper.1.dylib": "libwhisper.1.dylib",
      "binaries/libggml.0.dylib": "libggml.0.dylib",
      "binaries/libggml-base.0.dylib": "libggml-base.0.dylib"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
