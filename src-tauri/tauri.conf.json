{
  "productName": "Turbo Talk",
  "version": "0.8.13",
  "identifier": "io.librewin.turbotalk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1428",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Turbo Talk",
        "width": 440,
        "height": 280,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "resizable": false,
        "center": true,
        "transparent": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "",
        "width": 360,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "",
        "width": 460,
        "height": 280,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": true,
        "focus": false,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "cursor-dot",
        "title": "",
        "width": 20,
        "height": 20,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBREY0NTM2QUJBNDU0QTQKUldTa1ZLU3JOa1hmR25rQytkaDZjNkgrMzU0eWtVcGcvNmdiekl1VlpmMldZQmxmcGpncWRhelcK",
      "endpoints": [
        "https://github.com/eldo9000/TurboTalk-App/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/whisper-cli", "binaries/whisper-server"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
